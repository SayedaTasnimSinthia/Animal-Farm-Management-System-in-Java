<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="720.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.employeeRelated.ViewSalaryHistory">

    <children>
        <Rectangle fill="#32726b" height="50.0" width="720.0" />
        <Label layoutX="10" layoutY="10" text="🐏🐓 Animal Farm 360" textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="24.0" />
            </font>
        </Label>
        <Button fx:id="backButton" layoutX="665.0" layoutY="13.0" onAction="#handleBack" text="Back" />
        <TableView fx:id="salaryTable" layoutX="10" layoutY="60" prefHeight="460" prefWidth="700">
            <columns>
                <TableColumn fx:id="monthColumn" prefWidth="200" text="Month/Year" />
                <TableColumn fx:id="amountColumn" prefWidth="222.0" text="Amount" />
                <TableColumn fx:id="statusColumn" prefWidth="277.0" text="Status" />
            </columns>
        </TableView>
        <Label layoutX="10" layoutY="530" prefWidth="700" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
            <font>
                <Font size="10" />
            </font>
        </Label>
    </children>
</AnchorPane>
