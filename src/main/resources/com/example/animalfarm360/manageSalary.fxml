<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="551.0" prefWidth="649.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.adminRelated_EmployeeRelated.ManageSalary">

    <children>
        <Rectangle fill="#32726b" height="50.0" layoutX="0.0" layoutY="0.0" width="737.0" />
        <Label layoutX="4.0" layoutY="8.0" prefHeight="35.0" prefWidth="257.0" text="🐏🐓 Animal Farm 360 " textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="24.0" />
            </font>
        </Label>
        <Label layoutX="4.0" layoutY="523.0" prefHeight="27.0" prefWidth="688.0" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
            <font>
                <Font size="10.0" />
            </font>
        </Label>
        <Label layoutX="20.0" layoutY="70.0" text="Employee ID:" textFill="#1d1d9e" />
        <TextField fx:id="employeeIdField" layoutX="120.0" layoutY="66.0" prefWidth="120.0" />
        <Label layoutX="20.0" layoutY="110.0" text="Month:" textFill="#1d1d9e" />
        <DatePicker fx:id="monthPicker" layoutX="120.0" layoutY="106.0" prefWidth="180.0" />
        <Label layoutX="20.0" layoutY="150.0" text="Payment Status:" textFill="#1d1d9e" />
        <RadioButton fx:id="paidRadio" layoutX="120.0" layoutY="150.0" text="Paid">
         <toggleGroup>
            <ToggleGroup fx:id="paymentGroup" />
         </toggleGroup></RadioButton>
        <RadioButton fx:id="unpaidRadio" layoutX="193.0" layoutY="150.0" text="Unpaid" toggleGroup="$paymentGroup" />
        <Button layoutX="520.0" layoutY="66.0" mnemonicParsing="false" onAction="#searchSalary" prefWidth="100.0" text="Search" />
        <Button layoutX="520.0" layoutY="106.0" mnemonicParsing="false" onAction="#saveSalary" prefWidth="100.0" text="Save" />
        <Button layoutX="644.0" layoutY="13.0" mnemonicParsing="false" onAction="#backAction" prefHeight="25.0" prefWidth="70.0" text="Back" />
        <Label fx:id="message" layoutX="79.0" layoutY="176.0" prefHeight="25.0" prefWidth="600.0" textFill="green" />
        <TableView fx:id="salaryTable" layoutX="14.0" layoutY="215.0" prefHeight="280.0" prefWidth="710.0">
            <columns>
                <TableColumn fx:id="monthColumn" prefWidth="214.0" text="Month &amp; Year" />
                <TableColumn fx:id="amountColumn" prefWidth="252.0" text="Amount" />
                <TableColumn fx:id="statusColumn" prefWidth="242.0" text="Status" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
