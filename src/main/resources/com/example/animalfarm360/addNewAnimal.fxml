<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="NEVER" prefHeight="600.0" prefWidth="700.0" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.adminRelated_AnimalManagementRelated.AddNewAnimal">

    <content>
        <AnchorPane prefHeight="950" prefWidth="700.0" style="-fx-background-color: white;">
            <children>
                <Rectangle fill="#32726b" height="50.0" layoutX="0.0" layoutY="0.0" width="737.0" />
                <Label layoutX="4.0" layoutY="8.0" prefHeight="35.0" prefWidth="257.0" text="🐏🐓 Animal Farm 360 " textFill="WHITE">
                    <font>
                        <Font name="System Bold Italic" size="24.0" />
                    </font>
                </Label>
                <Button layoutX="629.0" layoutY="13.0" mnemonicParsing="false" onAction="#backAction" text="Back" />
                <Label alignment="CENTER" layoutX="1.0" layoutY="60.0" prefHeight="35.0" prefWidth="683.0" text="Animal Information" textFill="#2a2a86" underline="true">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label layoutX="20.0" layoutY="110.0" text="Animal ID:" textFill="#2a2fbf" />
                <TextField fx:id="animalIdField" layoutX="250.0" layoutY="110.0" prefWidth="350.0" />
                <Label layoutX="20.0" layoutY="145.0" text="Category:" textFill="#2a2fbf" />
                <ComboBox fx:id="categoryComboBox" layoutX="250.0" layoutY="145.0" prefWidth="350.0" />
                <Label layoutX="20.0" layoutY="180.0" text="Breed:" textFill="#2a2fbf" />
                <ComboBox fx:id="breedComboBox" layoutX="250.0" layoutY="180.0" prefWidth="350.0" />
                <Label layoutX="20.0" layoutY="215.0" text="Date of Birth:" textFill="#2a2fbf" />
                <DatePicker fx:id="dobField" layoutX="250.0" layoutY="215.0" />
                <Label layoutX="20.0" layoutY="250.0" text="Gender:" textFill="#2a2fbf" />
                <RadioButton layoutX="250.0" layoutY="250.0" text="Male">
                    <toggleGroup>
                        <ToggleGroup fx:id="genderGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton layoutX="320.0" layoutY="250.0" text="Female" toggleGroup="$genderGroup" />
                <Label layoutX="20.0" layoutY="285.0" text="Upload Image:" textFill="#2a2fbf" />
                <ImageView fx:id="animalImageView" fitHeight="100" fitWidth="100" layoutX="250.0" layoutY="285.0" pickOnBounds="true" preserveRatio="true" />
                <Button layoutX="370.0" layoutY="285.0" onAction="#uploadImage" text="Browse Image" />
                <Label layoutX="20.0" layoutY="400.0" text="Health Status:" textFill="#2a2fbf" />
                <RadioButton layoutX="250.0" layoutY="400.0" text="Healthy">
                    <toggleGroup>
                        <ToggleGroup fx:id="healthStatusGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton layoutX="320.0" layoutY="400.0" text="Sick" toggleGroup="$healthStatusGroup" />
                <RadioButton layoutX="380.0" layoutY="400.0" text="Injured" toggleGroup="$healthStatusGroup" />
                <RadioButton layoutX="470.0" layoutY="400.0" text="Dead" toggleGroup="$healthStatusGroup" />
                <Label layoutX="20.0" layoutY="435.0" text="Notes:" textFill="#2a2fbf" />
                <TextArea fx:id="notesField" layoutX="250.0" layoutY="435.0" prefHeight="80.0" prefWidth="350.0" />
                <Label layoutX="20.0" layoutY="530.0" text="Productivity:" textFill="#2a2fbf" />
                <RadioButton layoutX="250.0" layoutY="530.0" text="Milk Yield">
                    <toggleGroup>
                        <ToggleGroup fx:id="productivityGroup" />
                    </toggleGroup>
                </RadioButton>
                <TextField fx:id="milkYieldField" layoutX="380.0" layoutY="530.0" prefWidth="100.0" promptText="Liters" />
                <RadioButton layoutX="250.0" layoutY="565.0" text="Egg Count" toggleGroup="$productivityGroup" />
                <TextField fx:id="eggCountField" layoutX="380.0" layoutY="565.0" prefWidth="100.0" promptText="Count" />
                <RadioButton layoutX="250.0" layoutY="600.0" text="Meat Yield" toggleGroup="$productivityGroup" />
                <TextField fx:id="meatYieldField" layoutX="380.0" layoutY="600.0" prefWidth="100.0" promptText="Kg" />
                <RadioButton layoutX="250.0" layoutY="635.0" text="Wool" toggleGroup="$productivityGroup" />
                <TextField fx:id="woolField" layoutX="380.0" layoutY="635.0" prefWidth="100.0" promptText="Kg" />
                <RadioButton layoutX="250.0" layoutY="670.0" text="Only for Sale" toggleGroup="$productivityGroup" />
                <Label layoutX="20.0" layoutY="710.0" text="Sale Status:" textFill="#2a2fbf" />
                <RadioButton layoutX="250.0" layoutY="710.0" text="Available">
                    <toggleGroup>
                        <ToggleGroup fx:id="saleStatusGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton layoutX="340.0" layoutY="710.0" text="Sold" toggleGroup="$saleStatusGroup" />
                <RadioButton layoutX="420.0" layoutY="710.0" text="Not for Sale" toggleGroup="$saleStatusGroup" />
                <Label layoutX="20.0" layoutY="745.0" text="Sale Price:" textFill="#2a2fbf" />
                <TextField fx:id="salePriceField" layoutX="250.0" layoutY="745.0" prefWidth="150.0" />
                <Label layoutX="20.0" layoutY="780.0" text="System Flag:" textFill="#2a2fbf" />
                <RadioButton layoutX="250.0" layoutY="780.0" text="Active">
                    <toggleGroup>
                        <ToggleGroup fx:id="systemFlagGroup" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton layoutX="320.0" layoutY="780.0" text="Inactive" toggleGroup="$systemFlagGroup" />
                <Button layoutX="250.0" layoutY="820.0" onAction="#saveAnimal" prefWidth="200" text="Save Animal" />
                <Label layoutX="17.0" layoutY="860.0" prefHeight="27.0" prefWidth="688.0" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
                    <font>
                        <Font size="10.0" />
                    </font>
                </Label>
            </children>
        </AnchorPane>
    </content>
</ScrollPane>
