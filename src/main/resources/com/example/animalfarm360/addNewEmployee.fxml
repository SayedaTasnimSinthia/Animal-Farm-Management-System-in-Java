                <Label layoutX="4.0" layoutY="8.0" prefHeight="35.0" prefWidth="257.0" text="🐏🐓 Animal Farm 360 " textFill="WHITE">
                    <font>
                        <Font name="System Bold Italic" size="24.0" />
                    </font>
                </Label>
                <Button layoutX="629.0" layoutY="13.0" mnemonicParsing="false" onAction="#backAction" text="Back" />
                <Label layoutX="200.0" layoutY="60.0" text="Employee Information" textFill="#2a2a86" underline="true">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
            <Label layoutX="20.0" layoutY="100.0" text="Full Name:" textFill="#2a2fbf" />
            <TextField fx:id="nameField" layoutX="250.0" layoutY="100.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="135.0" text="Date of Birth:" textFill="#2a2fbf" />
            <DatePicker fx:id="dobField" layoutX="250.0" layoutY="135.0" />
            <Label layoutX="20.0" layoutY="170.0" text="Gender:" textFill="#2a2fbf" />
            <RadioButton layoutX="250.0" layoutY="170.0" text="Male">
                <toggleGroup>
                    <ToggleGroup fx:id="genderGroup" />
                </toggleGroup>
            </RadioButton>
            <RadioButton layoutX="320.0" layoutY="170.0" text="Female" toggleGroup="$genderGroup" />
            <Label layoutX="20.0" layoutY="195.0" text="Phone Number:" textFill="#2a2fbf" />
            <TextField fx:id="phoneField" layoutX="250.0" layoutY="195.0" prefWidth="350.0" />

            <Label layoutX="20.0" layoutY="230.0" text="Address:" textFill="#2a2fbf" />
            <TextField fx:id="addressField" layoutX="250.0" layoutY="230.0" prefWidth="350.0" />

            <Label layoutX="20.0" layoutY="265.0" text="Email:" textFill="#2a2fbf" />
            <TextField fx:id="emailField" layoutX="250.0" layoutY="265.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="300.0" text="Employee ID:" textFill="#2a2fbf" />
            <TextField fx:id="employeeIdField" layoutX="250.0" layoutY="300.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="335.0" text="Department:" textFill="#2a2fbf" />
            <ComboBox fx:id="departmentComboBox" layoutX="250.0" layoutY="335.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="370.0" text="Position:" textFill="#2a2fbf" />
            <ComboBox fx:id="positionComboBox" layoutX="250.0" layoutY="370.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="405.0" text="Date of Joining:" textFill="#2a2fbf" />
            <DatePicker fx:id="dojField" layoutX="250.0" layoutY="405.0" />
            <Label layoutX="20.0" layoutY="440.0" text="Employment Status:" textFill="#2a2fbf" />
