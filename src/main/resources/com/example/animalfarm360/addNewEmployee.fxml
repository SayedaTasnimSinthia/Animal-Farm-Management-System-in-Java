            <RadioButton layoutX="539.0" layoutY="440.0" text="Left the Job" toggleGroup="$employmentStatusGroup" />
            <Label layoutX="20.0" layoutY="475.0" text="Employee Type:" textFill="#2a2fbf" />
            <TextField fx:id="employeeTypeField" layoutX="250.0" layoutY="475.0" prefWidth="350.0" promptText="Full Time (5 am to 5 pm) / Part Time (10 am to 5 pm)" />
            <Label layoutX="20.0" layoutY="510.0" text="Username:" textFill="#2a2fbf" />
            <TextField fx:id="usernameField" layoutX="250.0" layoutY="510.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="545.0" text="Password:" textFill="#2a2fbf" />
            <PasswordField fx:id="passwordField" layoutX="250.0" layoutY="545.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="580.0" text="Salary:" textFill="#2a2fbf" />
            <TextField fx:id="salaryField" layoutX="250.0" layoutY="580.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="615.0" text="Emergency Contact Name:" textFill="#2a2fbf" />
            <TextField fx:id="emergencyNameField" layoutX="250.0" layoutY="615.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="650.0" text="Emergency Contact Phone:" textFill="#2a2fbf" />
            <TextField fx:id="emergencyPhoneField" layoutX="250.0" layoutY="650.0" prefWidth="350.0" />
            <Label layoutX="20.0" layoutY="685.0" text="Upload Image:" textFill="#2a2fbf" />
            <ImageView fx:id="imageView" fitHeight="100" fitWidth="100" layoutX="250.0" layoutY="685.0" pickOnBounds="true" preserveRatio="true" />
            <Button layoutX="370.0" layoutY="685.0" mnemonicParsing="false" onAction="#uploadImage" text="Browse Image" />
            <Button layoutX="250.0" layoutY="770.0" mnemonicParsing="false" onAction="#saveEmployee" prefWidth="200" text="Save Employee" />
            <Label layoutX="17.0" layoutY="815.0" prefHeight="27.0" prefWidth="688.0" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
                <font>
                    <Font size="10.0" />
                </font>
            </Label>
            </children>
        </AnchorPane>
    </content>
</ScrollPane>
