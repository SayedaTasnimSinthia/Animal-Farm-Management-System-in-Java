<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="513.0" prefWidth="737.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.controller.EmployeeLogin">

    <children>
        <Rectangle fill="#32726b" height="50.0" layoutX="0.0" layoutY="0.0" width="737.0" />
        <Label layoutX="4.0" layoutY="8.0" prefHeight="35.0" prefWidth="257.0" text="🐏🐓 Animal Farm 360 " textFill="WHITE">
            <font>
                <Font name="System Bold Italic" size="24.0" />
            </font>
        </Label>
        <Label layoutX="14.0" layoutY="479.0" prefHeight="35.0" prefWidth="688.0" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
            <font>
                <Font size="10.0" />
            </font>
        </Label>
        <ComboBox fx:id="loginCombo" layoutX="645.0" layoutY="13.0" onAction="#Login" prefHeight="25.0" prefWidth="72.0" promptText="Login" style="-fx-background-color: #50c6b4; -fx-text-fill: white;" />
        <Label fx:id="about" layoutX="437.0" layoutY="16.0" onMouseClicked="#About" text="About" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="bookVisit" layoutX="361.0" layoutY="16.0" onMouseClicked="#Booking" text="Book Visit" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="home" layoutX="310.0" layoutY="16.0" onMouseClicked="#Home" text="Home" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="contact" layoutX="486.0" layoutY="16.0" onMouseClicked="#ContactInfo" text="Contact Us" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="review" layoutX="565.0" layoutY="16.0" onMouseClicked="#Review" text="Reviews" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>

        <Label alignment="CENTER" layoutX="1.0" layoutY="60.0" prefHeight="35.0" prefWidth="731.0" style="-fx-font-size: 24; -fx-font-weight: bold;" text="&quot;Employee LOGIN&quot;" textFill="#248677" underline="true">
            <font>
                <Font name="System Bold" size="13.0" />
            </font></Label>
        <TextField fx:id="usernameField" layoutX="267.0" layoutY="104.0" prefWidth="200" promptText="Username" />
        <PasswordField fx:id="passwordField" layoutX="267.0" layoutY="143.0" prefWidth="200" promptText="Password" />
        <Button layoutX="348.0" layoutY="179.0" onAction="#LoginEmployee" text="LOGIN" textFill="#196535">
            <font>
                <Font name="System Bold" size="12.0" />
            </font></Button>
        <Label fx:id="messageLabel" alignment="CENTER" layoutX="271.0" layoutY="222.0" prefWidth="200" style="-fx-text-fill: red;" />
        <Button fx:id="buttonViewDetails" alignment="CENTER" layoutX="271.0" layoutY="268.0" onAction="#ViewDetails" prefWidth="200" text="View Your Details" textFill="#305cbc" visible="true">
            <font>
                <Font name="System Bold" size="13.0" />
            </font></Button>
        <Button fx:id="buttonViewAttandance" alignment="CENTER" layoutX="271.0" layoutY="315.0" onAction="#ViewAttandence" prefWidth="200" text="View Attendance Record" textFill="#305cbc" visible="true">
            <font>
                <Font name="System Bold" size="13.0" />
            </font></Button>

        <Button fx:id="buttonViewSalary" alignment="CENTER" layoutX="271.0" layoutY="361.0" onAction="#ViewSalary" prefWidth="200" text="View Salary Record" textFill="#305cbc" visible="true">
            <font>
                <Font name="System Bold" size="13.0" />
            </font></Button>


    </children>
</AnchorPane>
