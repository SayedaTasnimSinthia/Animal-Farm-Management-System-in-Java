<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="546.0" prefWidth="720.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.adminRelated_VisitRelated.ManageVisits">
    <TableView fx:id="bookingTable" layoutX="14.0" layoutY="66.0" prefHeight="400.0" prefWidth="705.0">
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="100" text="Name" />
            <TableColumn fx:id="emailColumn" prefWidth="128.0" text="Email" />
            <TableColumn fx:id="phoneColumn" prefWidth="108.0" text="Phone" />
            <TableColumn fx:id="dateColumn" prefWidth="94.0" text="Date" />
            <TableColumn fx:id="timeColumn" prefWidth="70" text="Time" />
            <TableColumn fx:id="contactedColumn" prefWidth="97.0" text="Contacted" />
            <TableColumn fx:id="approvedColumn" prefWidth="114.0" text="Approved" />
        </columns>
    </TableView>
    <Label layoutX="21.0" layoutY="484.0" text="Contacted:" textFill="#291ec6" />
    <RadioButton fx:id="contactedYesRadio" layoutX="94.0" layoutY="484.0" text="Yes">
      <toggleGroup>
         <ToggleGroup fx:id="contactedGroup" />
      </toggleGroup></RadioButton>
    <RadioButton fx:id="contactedNoRadio" layoutX="160.0" layoutY="484.0" text="No" toggleGroup="$contactedGroup" />
    <Label layoutX="247.0" layoutY="484.0" text="Approved:" textFill="#2347bc" />
    <RadioButton fx:id="approvedYesRadio" layoutX="317.0" layoutY="484.0" text="Yes">
      <toggleGroup>
         <ToggleGroup fx:id="approvedGroup" />
      </toggleGroup></RadioButton>
    <RadioButton fx:id="approvedNoRadio" layoutX="381.0" layoutY="484.0" text="No" toggleGroup="$approvedGroup" />
    <Button layoutX="498.0" layoutY="480.0" onAction="#saveChanges" text="Save Changes" />
   <Label layoutY="519.0" prefHeight="27.0" prefWidth="688.0" text="   © 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
      <font>
         <Font size="10.0" />
      </font>
   </Label>
   <Rectangle fill="#32726b" height="50.0" layoutX="-2.0" width="737.0" />
   <Button layoutX="680.0" layoutY="13.0" mnemonicParsing="false" onAction="#BackAction" text="Back" />
   <Label layoutX="5.0" layoutY="8.0" prefHeight="35.0" prefWidth="257.0" text="🐏🐓 Animal Farm 360 " textFill="WHITE">
      <font>
         <Font name="System Bold Italic" size="24.0" />
      </font>
   </Label>

</AnchorPane>
