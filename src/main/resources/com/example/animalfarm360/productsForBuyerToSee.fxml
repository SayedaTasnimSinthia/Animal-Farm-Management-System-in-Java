<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.animalfarm360.buyerRelated.ProductsForBuyerToSee">
    <children>
        <Rectangle fill="#32726b" height="50.0" width="900.0" />
        <Label layoutX="10.0" layoutY="10.0" text="🐏🐓 Animal Farm 360" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <TextField fx:id="searchField" layoutX="308.0" layoutY="14.0" prefWidth="200.0" promptText="Search by name" />
        <Button layoutX="525.0" layoutY="14.0" onAction="#searchProduct" text="Search" />
        <Button layoutX="728.0" layoutY="13.0" onAction="#goToCart" text="Cart 🛒" />
        <Label layoutX="20.0" layoutY="70.0" text="Animals For Sale:" textFill="#2a2fbf" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <ScrollPane hbarPolicy="NEVER" layoutX="20.0" layoutY="100.0" prefHeight="200.0" prefWidth="860.0" style="-fx-border-color: #cccccc;" vbarPolicy="ALWAYS">
            <content>
                <AnchorPane fx:id="animalContainer" minHeight="200.0" prefWidth="840.0" style="-fx-background-color: white;" />
            </content>
        </ScrollPane>
        <Label layoutX="20.0" layoutY="320.0" text="Animal-based Products:" textFill="#2a2fbf" underline="true">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <ScrollPane hbarPolicy="NEVER" layoutX="20.0" layoutY="350.0" prefHeight="200.0" prefWidth="860.0" style="-fx-border-color: #cccccc;" vbarPolicy="ALWAYS">
            <content>
                <AnchorPane fx:id="productContainer" minHeight="200.0" prefWidth="840.0" style="-fx-background-color: white;" />
            </content>
        </ScrollPane>
      <Button layoutX="828.0" layoutY="13.0" onAction="#back" text="Back" />
      <Label layoutX="-1.0" layoutY="573.0" prefHeight="27.0" prefWidth="699.0" text="© 2025 Animal Farm 360 | All Rights Reserved" textFill="#a89e9e">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
